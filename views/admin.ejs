<div>
  <div class="card">
    <h1>Admin Panel</h1>
    <p>This page is only accessible to users with admin role.</p>
    <div class="card" style="background:#f3e8ff;">
      <h3>Admin Access Granted!</h3>
      <p>Welcome, <strong><%= user.name || user.preferred_username || user.email %></strong>!<br>You have administrative privileges.</p>
    </div>
    <div class="card">
      <h2>Admin Information</h2>
      <ul>
        <li><b>User ID:</b> <span style="font-family:monospace;"><%= user.sub %></span></li>
        <li><b>Email:</b> <%= user.email %></li>
        <li><b>Name:</b> <%= user.name || 'Not provided' %></li>
        <li><b>Username:</b> <%= user.preferred_username || 'Not provided' %></li>
        <li><b>Roles:</b> <%= user.roles && user.roles.length > 0 ? user.roles.join(', ') : 'No roles assigned' %></li>
      </ul>
    </div>
    <div class="card">
      <h2>Admin Actions</h2>
      <div>
        <button onclick="getDatabaseStats()" class="btn">Get Stats</button>
        <button onclick="getAllUsers()" class="btn" style="background:#22c55e;">View Users</button>
        <button onclick="getSystemHealth()" class="btn" style="background:#facc15; color:#333;">Health Check</button>
      </div>
    </div>
    <div id="results" class="card" style="display:none;">
      <h2>Results</h2>
      <pre id="resultsContent" style="background:#f1f5f9; padding:1rem; border-radius:6px; max-height:300px; overflow:auto;"></pre>
    </div>
    <div>
      <a href="/protected" class="btn" style="background:#eee;color:#333;">Back to Protected</a>
      <a href="/public" class="btn">Go to Public</a>
    </div>
  </div>
</div>
<script>
async function getDatabaseStats() {
    try {
        const response = await fetch('/api/admin/stats');
        const data = await response.json();
        displayResults('Database Statistics', data);
    } catch (error) {
        displayResults('Error', { error: error.message });
    }
}
async function getAllUsers() {
    try {
        const response = await fetch('/api/admin/users');
        const data = await response.json();
        displayResults('All Users', data);
    } catch (error) {
        displayResults('Error', { error: error.message });
    }
}
async function getSystemHealth() {
    try {
        const response = await fetch('/api/health');
        const data = await response.json();
        displayResults('System Health', data);
    } catch (error) {
        displayResults('Error', { error: error.message });
    }
}
function displayResults(title, data) {
    const resultsDiv = document.getElementById('results');
    const resultsContent = document.getElementById('resultsContent');
    resultsContent.textContent = JSON.stringify(data, null, 2);
    resultsDiv.style.display = '';
    resultsDiv.scrollIntoView({ behavior: 'smooth' });
}
</script> 